<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-LN+7fdVzj6u52u30Kp6M/trliBMCMKTyK833zpbD+pXdCLuTusPj697FH4R/5mcr"
      crossorigin="anonymous"
    />
    <link href="/styles/content.css" rel="stylesheet" />
    <title>ศรีกรุง</title>
  </head>
  <body class="background-dark" data-device-id="<%=locals.id%>">
    <main class="d-flex justify-content-center align-items-center vh-100 ">
      <form action="/mainpage" method="POST" class="white px-4 pt-4 pb-5 rounded">
        <img src="images/icon.png"width="70px" />
        <div>โปรดเข้าสู่ระบบ</div>
        <div class="form-floating mb-3 mt-2">
          <input
            class="form-control"
            id="floatingInput"
            placeholder="เลขบัญชี"
            name="username"
            autocomplete="off"
            required
          />
          <label for="floatingInput">เลขบัญชี</label>
        </div>
        <label class="text-12">
          <input id="cfr" type="checkbox" name="cfr" value="true"/>
          บัญชีอยู่ใน cfr
        </label>
        <br />
        <label class="text-12">
          <input id="whiteList" type="checkbox" name="whiteList" value="true"/>
          บัญชีอยู่ใน white list
        </label>
        <button class="btn btn-warning w-100 py-2 mt-3 " type="submit">เข้าสู่ระบบ</button>
      </form>
    </main>
    <script src="/script.js" charset="utf-8"></script>
  </body>
</html>
