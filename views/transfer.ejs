<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-LN+7fdVzj6u52u30Kp6M/trliBMCMKTyK833zpbD+pXdCLuTusPj697FH4R/5mcr" crossorigin="anonymous">
      <link rel="preconnect" href="https://fonts.googleapis.com">
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
      <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@100;200;300;400;500;600;700&display=swap" rel="stylesheet">
      <link href="/styles/content.css" rel='stylesheet'>
    <title>ศรีกรุง</title>
</head>
  <header class="p-3 text-bg-dark">
          <div class="d-flex align-items-center justify-content-start justify-content-lg-start">
              <span class="bank">ศรีกรุง</span>
          </div>
      </div>
  </header>
<body data-device-id="<%=locals.id%>">
    <div class="d-flex justify-content-center ">
        <div class="background transaction-container">
            <div class="my-2 text-12">จากบัญชี:</div>
            <div><%=content.username%></div><hr class="horizontal"/>
            <div class="my-2 text-12">ถึงบัญชี:</div>
            <% if (locals.target == "undefined"){ %>
                <select id="myDropdown">
                    <option value="0" selected disabled>-- เลขบัญชีปลายทาง --</option>
                </select>
            <% } else{ %>
            <select id="myDropdown" disabled>
                <option value="<%=target%>" selected><%=targetName%></option>
            </select>
            <% } %>
            <hr class="horizontal"/>
            <div class="my-2 text-12">จำนวนเงิน:</div>
            <div class="amount-frame"><input id="amount" type="text" placeholder="บาท" min='1' oninput="updateBufferState()" autocomplete="off"/></div><hr class="horizontal"/>
            <div>บันทึกช่วยจำ</div>
            <div class="note-frame"><input id="note" placeholder="เติมข้อความที่นี่"/></div><hr class="horizontal"/>
            <div class="form-switch d-flex justify-content-start my-2"style="gap: 60px; padding: 0px">
                <label class="form-check-label" for="flexSwitchCheck">บัฟเฟอร์</label>
                <input class="form-check-input" type="checkbox" id="flexSwitchCheck" />
            </div>
            <div class="d-flex justify-content-between  mt-5" style="width:100%;">
                <button class="btn btn-dark rounded-pill px-3" style="font-size: 0.95em; width: 100px" onclick="mainPage()">ยกเลิก</button>
                <button class="btn btn-dark text-yellow rounded-pill px-3 " type="button" style="width: 100px" onclick="successPage()">โอนเงิน</button>
            </div>
        </div>
    </div>
    <script
          src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"
          integrity="sha384-ndDqU0Gzau9qJ1lfW4pNLlhNTkCfHzAVBReH9diLvGRem5+R9g2FzA8ZGN954O5Q"
          crossorigin="anonymous">
    </script>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="/script.js" charset="utf-8"></script>
    <script>
        const dropdown = document.getElementById("myDropdown");
        var usernameList = <%- JSON.stringify(usernameList) %>;
        for (var i=0; i<usernameList.length; i++){
            if (usernameList[i] === "<%=content.username%>") continue;
            const option = document.createElement("option")
            option.value = i+1;
            option.textContent = usernameList[i]
            dropdown.appendChild(option);
        }
        function updateBufferState(){
            var amount = Number($("#amount").val());
            var state = bufferState(<%=whiteList%>, "<%=process%>", amount, <%=locals.cfr%>);
            if (state === "open"){
                $("#flexSwitchCheck").prop("checked", true).prop("disabled", true)
            }
            else if (state === "close"){
                $("#flexSwitchCheck").prop("checked", false).prop("disabled", true)
            }
            else {
                $("#flexSwitchCheck").prop("disabled", false)
            }
        }
    </script>
</body>
</html>