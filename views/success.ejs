<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-LN+7fdVzj6u52u30Kp6M/trliBMCMKTyK833zpbD+pXdCLuTusPj697FH4R/5mcr" crossorigin="anonymous">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@100;200;300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="/styles/content.css" rel='stylesheet'>
    <title>ศรีกรุง</title>
  </head>
  <header class="p-3 text-bg-dark">
    <div
      class="d-flex align-items-center justify-content-start justify-content-lg-start"
    >
      <span class="bank">ศรีกรุง</span>
    </div>
  </header>
  <body data-device-id="<%=locals.id%>">
    <div class="px-4 pt-5 pb-2 mt-5 text-center">
      <img
        class="d-block mx-auto"
        src="/images/success.png"
        alt="success image"
        width="300rem"
        height="auto"
      />
      <h1 class="display-5 fw-bold text-body-emphasis">โอนเงินสำเร็จ</h1>
      <div class="col-lg-6 mx-auto">
        <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
          <button class="btn btn-link rounded-pill px-3" type="button" onclick="mainPage()">กลับหน้าหลัก</button>
        </div>
      </div>
    </div>
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-ndDqU0Gzau9qJ1lfW4pNLlhNTkCfHzAVBReH9diLvGRem5+R9g2FzA8ZGN954O5Q"
      crossorigin="anonymous"
    ></script>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="/script.js" charset="utf-8"></script>
  </body>
</html>
