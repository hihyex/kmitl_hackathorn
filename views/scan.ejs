<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-LN+7fdVzj6u52u30Kp6M/trliBMCMKTyK833zpbD+pXdCLuTusPj697FH4R/5mcr" crossorigin="anonymous">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@100;200;300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="/styles/content.css" rel='stylesheet'>
    <title>ศรีกรุง</title>
  </head>
<header class="p-3 text-bg-dark pb-0">
  <div>
    <div class="d-flex flex-wrap align-items-center justify-content-between justify-content-lg-between">
        <span class="bank">ศรีกรุง</span>
    </div>
    <span class="account-number">เลขบัญชี: <%=locals.content.username %></span>
  </div>
  </div>
</header>
  <body data-device-id="<%=locals.id%>">
    <% if (locals.message) { %>
        <script>
            alert("<%=message %>")
            window.location.href = `/mainpage/<%=id%>`;
        </script>
    <% } else { %>
        <div class="qr-container">
            <img id="qr-img" src="/images/qrcode.png" alt="QR Code"/>
            <div>
            <div class="below-qr">qr-code นี้เป็นเพียงรูปภาพประกอบเท่านั้น</div>
            <select id="myDropdown" class="mt-3">
                <option value="0" selected disabled>-- เลขบัญชีปลายทาง --</option>
            </select>
        </div>
            <div class="d-flex justify-content-between" style="width:100%">
                <button style="width: 100px"class="btn btn-dark rounded-pill px-3 m-5" type="button" onclick="mainPage()">
                    <span class="text-gray text-16" style="margin-left: 7px;">ย้อนกลับ</span>
                </button>
                <button style="width: 100px"class="btn btn-dark rounded-pill px-3 m-5" type="button" onclick="transfer('scan')">
                    <span class="text-yellow text-16" style="margin-left: 7px">ต่อไป</span>
                </button>
            </div>
        </div>
    <% } %>
    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-ndDqU0Gzau9qJ1lfW4pNLlhNTkCfHzAVBReH9diLvGRem5+R9g2FzA8ZGN954O5Q"
        crossorigin="anonymous">
    </script>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="/script.js" charset="utf-8"></script>
    <script>
        const dropdown = document.getElementById("myDropdown");
        var usernameList = <%- JSON.stringify(usernameList) %>;
        for (var i=0; i<usernameList.length; i++){
            if (usernameList[i] === "<%=content.username%>") continue;
            const option = document.createElement("option")
            option.value = i+1;
            option.textContent = usernameList[i]
            dropdown.appendChild(option);
        }
    </script>
</body>
  </body>
</html>
